PORT=3000
DB_PATH=./data/colony-watch.sqlite
# true seeds fictional colonies and enables clearly labeled demo scenarios.
DEMO_MODE=true
# Optional server-side cat photo classification. Never put this key in public/.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
# Provision a station in the dashboard to get its one-time device key.
DEVICE_ID=
DEVICE_API_KEY=
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=115200
API_URL=http://127.0.0.1:3000
GATEWAY_OUTBOX=./gateway/outbox.jsonl
